    <fa-icon [icon]=\"faUsers\" class=\"icone-kpi\"></fa-icon>\n            <h3>Utilizadores</h3>\n            <strong>{{ dashboard?.totalUtilizadores }}</strong>\n            <small>Total de contas registadas</small>\n          </div>\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faFileAlt\" class=\"icone-kpi\"></fa-icon>\n            <h3>Publica\\xE7\\xF5es</h3>\n            <strong>{{ dashboard?.totalPublicacoes }}</strong>\n            <small>Total de publica\\xE7\\xF5es ativas</small>\n          </div>\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faFire\" class=\"icone-kpi\"></fa-icon>\n            <h3>Bazes</h3>\n            <strong>{{ dashboard?.totalBazes }}</strong>\n            <small>Total de intera\\xE7\\xF5es</small>\n          </div>\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faFlag\" class=\"icone-kpi\"></fa-icon>\n            <h3>Den\\xFAncias</h3>\n            <strong>{{ dashboard?.totalDenuncias }}</strong>\n            <small>Total de den\\xFAncias recebidas</small>\n          </div>\n        </div>\n\n        <div class=\"metrica-laboral\">\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faHourglassHalf\" class=\"icone-kpi\"></fa-icon>\n            <h3>Den\\xFAncias Pendentes</h3>\n            <strong>{{ dashboard?.denunciasPendentes }}</strong>\n            <small>Aguardando revis\\xE3o</small>\n          </div>\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faUserCheck\" class=\"icone-kpi\"></fa-icon>\n            <h3>Contas Ativas</h3>\n            <strong>{{ dashboard?.utilizadoresAtivos }}</strong>\n            <small>Utilizadores com conta ativa</small>\n          </div>\n          <div class=\"cartao cartao-kpi\">\n            <fa-icon [icon]=\"faUserLock\" class=\"icone-kpi\"></fa-icon>\n            <h3>Perfis Privados</h3>\n            <strong>{{ dashboard?.utilizadoresPrivados }}</strong>