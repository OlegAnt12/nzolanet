ntor-analitico\">\n  <div class=\"topo-anali\">\n    <div class=\"area-navegacao\">\n      <button type=\"button\" class=\"btn btn-voltar\">\n        <fa-icon [icon]=\"voltarIcon\"></fa-icon>\n      </button>\n      <h1 class=\"titulo-desc-area\">Utilizadores</h1>\n    </div>\n  </div>\n\n  <ng-container *ngIf=\"carregando; else conteudo\">\n    <p class=\"estado-carregamento\">A carregar utilizadores...</p>\n  </ng-container>\n\n  <ng-template #conteudo>\n    <ng-container *ngIf=\"erro; else tabela\">\n      <p class=\"estado-erro\">{{ erro }}</p>\n    </ng-container>\n\n    <ng-template #tabela>\n      <div class=\"tabela-dados\">\n        <div class=\"area-desc-topo\">\n          <h3>Total: {{ utilizadores.length }} utilizadores</h3>\n          <button type=\"button\" class=\"btn btn-adicionar\" (click)=\"abrirModal()\">\n            <fa-icon [icon]=\"adicionarIcon\"></fa-icon>\n            Adicionar Utilizador\n          </button>\n        </div>\n\n        <div class=\"area-tabela\">\n          <table>\n            <thead>\n              <tr>\n                <th></th>\n                <th>ID</th>\n                <th>Nome</th>\n                <th>Username</th>\n                <th>Email</th>\n                <th>N\\xEDvel</th>\n                <th>Estado</th>\n                <th>Privacidade</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr *ngFor=\"let u of utilizadores\">\n                <td>\n                  <img\n                    [src]=\"u.fotoPerfil || 'assets/default-avatar.png'\"\n                    alt=\"Foto\"\n                    class=\"foto-utilizador\"\n                  />\n                </td>\n                <td>{{ u.id }}</td>\n                <td>{{ u.nomeCompleto }}</td>\n                <td>{{ u.nomeUtilizador }}</td>\n                <td>{{ u.email }}</td>\n                <td>{{ u.nivelAcesso === 1 ? 'Admin' : 'Normal' }}</td>\n                <td>\n                  <span class=\"badge\" [class.badge-ativa]=\"u.estadoConta === 0\"\n                       [class.badge-suspensa]=\"u.estadoConta === 1\"\n                       [class.badge-banida]=\"u.estadoConta === 2\">\n                    {{ u.estadoConta === 0 ? 'Ativa' : u.estadoConta === 1 ? 'Suspensa' : 'Banida' }}\n                  </span>\n                </td>\n                <td>{{ u.privacidade === 0 ? 'P\\xFAblico' : 'Privado' }}</td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </ng-template>\n  </ng-template>\n</div>\n\n<!-- Modal Adicionar Utilizador -->\n<div class=\"modal-overlay\" *ngIf=\"modalAberto\" (click)=\"fecharModal()\">\n  <div class=\"modal-contentor\" (click)=\"$event.stopPropagation()\">\n    <div class=\"modal-topo\">\n      <h2>Adicionar Utilizador</h2>\n      <button type=\"button\" class=\"btn-fechar-modal\" (click)=\"fecharModal()\">\n        <fa-icon [icon]=\"fecharIcon\"></fa-icon>\n      </button>\n    </div>\n\n    <form (ngSubmit)=\"onSubmit()\" #form=\"ngForm\">\n      <div class=\"campos-grid\">\n        <div class=\"campo-formulario\">\n          <label for=\"nomeCompleto\">Nome completo *</label>\n          <input\n            type=\"text\"\n            id=\"nomeCompleto\"\n            name=\"nomeCompleto\"\n            [(ngModel)]=\"novoUtilizador.nomeCompleto\"\n            required\n            #nomeInput=\"ngModel\"\n          />\n          <span class=\"erro-campo\" *ngIf=\"formSubmetido && nomeInput.invalid\">Obrigat\\xF3rio</span>\n        </div>\n\n        <div class=\"campo-formulario\">\n          <label for=\"nomeUtilizador\">Nome de utilizador *</label>\n          <input\n            type=\"text\"\n            id=\"nomeUtilizador\"\n            name=\"nomeUtilizador\"\n            [(ngModel)]=\"novoUtilizador.nomeUtilizador\"\n            required\n            #userInput=\"ngModel\"\n          />\n          <span class=\"erro-campo\" *ngIf=\"formSubmetido && userInput.invalid\">Obrigat\\xF3rio</span>\n        </div>\n\n        <div class=\"campo-formulario\">\n          <label for=\"email\">E-mail *</label>\n          <input\n            type=\"email\"\n            id=\"email\"\n            name=\"email\"\n            [(ngModel)]=\"novoUtilizador.email\"\n            required\n            email\n            #emailInput=\"ngModel\"\n          />\n          <span class=\"erro-campo\" *ngIf=\"formSubmetido && emailInput.invalid\">E-mail inv\\xE1lido</span>\n        </div>\n\n        <div class=\"campo-formulario\">\n          <label for=\"palavraPasse\">Palavra-passe *</label>\n          <input\n            type=\"password\"\n            id=\"palavraPasse\"\n            name=\"palavraPasse\"\n            [(ngModel)]=\"novoUtilizador.palavraPasse\"\n            required\n            minlength=\"6\"\n            #passInput=\"ngModel\"\n          />\n          <span class=\"erro-campo\" *ngIf=\"formSubmetido && passInput.invalid\">M\\xEDnimo 6 caracteres</span>\n        </div>\n\n        <div class=\"campo-formulario\">\n          <label for=\"genero\">G\\xE9nero</label>\n          <select id=\"genero\" name=\"genero\" [(ngModel)]=\"novoUtilizador.genero\">\n            <option [value]=\"0\">Masculino</option>\n            <option [value]=\"1\">Feminino</option>\n          </select>\n        </div>\n\n        <div class=\"campo-formulario\">\n          <label for=\"dataNascimento\">Data de nascimento</label>\n          <input\n            type=\"date\"\n            id=\"dataNascimento\"\n            name=\"dataNascimento\"\n            [(ngModel)]=\"novoUtilizador.dataNascimento\"\n          />\n        </div>\n      </div>\n\n      <p class=\"aviso-nivel\">N\\xEDvel de acesso: <strong>Admin</strong></p>\n\n      <p class=\"erro-geral\" *ngIf=\"criarErro\">{{ criarErro }}</p>\n\n      <div class=\"modal-acoes\">\n        <button type=\"button\" class=\"btn btn-cancelar\" (click)=\"fecharModal()\">Cancelar</button>\n        <button type=\"submit\" class=\"btn btn-criar\" [disabled]=\"criarCarregando\">\n          {{ criarCarregando ? 'A criar...' : 'Criar Utilizador' }}\n        </button>\n      </div>\n    </form>\n  </div>\n</div>\n`, styles: [\"/* src/app/modules/admin/pages/utilizadores.component/utilizadores.component.css */\\n.contentor-analitico {\\n  padding: 12px 16px 16px;\\n}\\n.topo-anali {\\n  display: flex;\\n  justify-content: space-between;\\n  align-items: center;\\n  margin-bottom: 16px;\\n}\\n.btn-voltar {\\n  width: 36px;\\n  height: 36px;\\n  border-radius: 50%;\\n  border: 1px solid silver;\\n  display: flex;\\n  align-items: center;\\n  justify-content: center;\\n  margin-right: 12px;\\n}\\n.area-navegacao {\\n  display: flex;\\n  align-items: center;\\n}\\n.tabela-dados {\\n  padding: 12px 12px 8px;\\n  background-color: buttonface;\\n}\\n.area-desc-topo {\\n  display: flex;\\n  align-items: center;\\n  justify-content: space-between;\\n  padding: 8px 12px;\\n  margin-bottom: 12px;\\n}\\n.area-tabela {\\n  width: 100%;\\n  overflow-x: auto;\\n}\\n.area-tabela table {\\n  width: 100%;\\n  border-collapse: collapse;\\n}\\n.area-tabela table th {\\n  padding: 8px 6px;\\n  text-align: left;\\n  font-weight: 600;\\n  font-size: 0.85rem;\\n  border-bottom: 2px solid #d1d5db;\\n}\\n.area-tabela table td {\\n  padding: 8px 6px;\\n  border-bottom: 1px solid #e5e7eb;\\n}\\n.area-tabela table tr:hover {\\n  background-color: rgba(0, 0, 0, 0.02);\\n}\\n.foto-utilizador {\\n  width: 36px;\\n  height: 36px;\\n  object-fit: cover;\\n  border-radius: 50%;\\n  border: 1px solid #d1d5db;\\n}\\n.badge {\\n  display: inline-block;\\n  padding: 2px 10px;\\n  border-radius: 12px;\\n  font-size: 0.8rem;\\n  font-weight: 500;\\n}\\n.badge-ativa {\\n  background-color: #d1fae5;\\n  color: #065f46;\\n}\\n.badge-suspensa {\\n  background-color: #fef3c7;\\n  color: #92400e;\\n}\\n.badge-banida {\\n  background-color: #fee2e2;\\n  color: #991b1b;\\n}\\n.btn-adicionar {\\n  display: inline-flex;\\n  align-items: center;\\n  gap