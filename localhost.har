gcontent-%COMP%]   select[_ngcontent-%COMP%] {\\n  width: 100%;\\n  padding: 8px 10px;\\n  border: 1px solid #d1d5db;\\n  border-radius: 6px;\\n  font-size: 0.85rem;\\n  outline: none;\\n  box-sizing: border-box;\\n}\\n.campo-formulario[_ngcontent-%COMP%]   input[_ngcontent-%COMP%]:focus, \\n.campo-formulario[_ngcontent-%COMP%]   select[_ngcontent-%COMP%]:focus {\\n  border-color: #4A90E2;\\n}\\n.erro-campo[_ngcontent-%COMP%] {\\n  color: #dc2626;\\n  font-size: 0.75rem;\\n  margin-top: 2px;\\n  display: block;\\n}\\n.erro-geral[_ngcontent-%COMP%] {\\n  color: #dc2626;\\n  font-size: 0.85rem;\\n  margin: 12px 0;\\n}\\n.aviso-nivel[_ngcontent-%COMP%] {\\n  font-size: 0.85rem;\\n  color: #6b7280;\\n  margin: 16px 0 8px;\\n  text-align: center;\\n}\\n.modal-acoes[_ngcontent-%COMP%] {\\n  display: flex;\\n  justify-content: flex-end;\\n  gap: 8px;\\n  margin-top: 16px;\\n}\\n.btn-cancelar[_ngcontent-%COMP%] {\\n  padding: 8px 16px;\\n  border: 1px solid #d1d5db;\\n  background: white;\\n  border-radius: 8px;\\n  cursor: pointer;\\n  font-size: 0.85rem;\\n}\\n.btn-criar[_ngcontent-%COMP%] {\\n  padding: 8px 16px;\\n  background-color: #4A90E2;\\n  color: white;\\n  border: none;\\n  border-radius: 8px;\\n  font-size: 0.85rem;\\n  font-weight: 600;\\n  cursor: pointer;\\n}\\n.btn-criar[_ngcontent-%COMP%]:disabled {\\n  opacity: 0.6;\\n  cursor: not-allowed;\\n}\\n@media (max-width: 768px) {\\n  .contentor-analitico[_ngcontent-%COMP%] {\\n    padding: 8px 10px;\\n  }\\n  .topo-anali[_ngcontent-%COMP%] {\\n    flex-direction: column;\\n    gap: 8px;\\n    align-items: flex-start;\\n  }\\n  .area-navegacao[_ngcontent-%COMP%] {\\n    width: 100%;\\n  }\\n  .area-desc-topo[_ngcontent-%COMP%] {\\n    flex-direction: column;\\n    gap: 8px;\\n  }\\n  .area-tabela[_ngcontent-%COMP%] {\\n    overflow-x: auto;\\n  }\\n  .area-tabela[_ngcontent-%COMP%]   table[_ngcontent-%COMP%]   th[_ngcontent-%COMP%], \\n   .area-tabela[_ngcontent-%COMP%]   table[_ngcontent-%COMP%]   td[_ngcontent